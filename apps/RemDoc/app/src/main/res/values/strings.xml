    <string name="onboarding_title_1">Quick local reminders</string>
    <string name="onboarding_body_1">RemDoc shows a short note after unlock and other events you choose. No account, no internet, no ads.</string>
    <string name="onboarding_title_2">Choose reliability</string>
    <string name="onboarding_body_2_reliable">Reliable mode uses a quiet foreground service and works best after unlock.</string>
    <string name="onboarding_body_2_economy">Economy mode avoids a persistent service. Some devices may miss unlock events after the app is killed.</string>
    <string name="onboarding_title_3">Choose display</string>
    <string name="onboarding_body_3_toast">System Toast needs no overlay permission and stays lightweight.</string>
    <string name="onboarding_body_3_card">Overlay card looks better and needs the draw-over-apps permission.</string>
